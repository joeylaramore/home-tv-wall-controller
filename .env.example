ROKU_WALL_PASSWORD=replace-with-a-long-unique-password
# Set to 1 only when a reverse proxy/firewall strictly limits trusted LAN/VPN clients.
ROKU_ALLOW_UNAUTHENTICATED_NETWORK=0
# Optional: enables the live-game picker for public YouTube broadcasts.
YOUTUBE_API_KEY=
# Optional: additional trusted VPN client subnets, e.g. a WireGuard CGNAT range.
ROKU_ALLOWED_CIDRS=
